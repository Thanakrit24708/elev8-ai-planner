/# ==========================================
# Google Classroom API (OAuth 2.0)
# ==========================================
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
CLASSROOM_COURSE_IDS=

# ==========================================
# AI Chat API Configuration
# ==========================================
AI_PROVIDER=openai
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# ==========================================
# n8n Automation Engine (Optional)
# ==========================================
N8N_WEBHOOK_URL=https://your-n8n-domain.com/webhook/project-planner

# ==========================================
# Storage Engine: 'sheets' (Google Sheets) or 'mysql' (XAMPP MariaDB)
# ==========================================
STORAGE_ENGINE=sheets
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ==========================================
# MariaDB Database (XAMPP Default)
# ==========================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=project_planner_db

# ==========================================
# Gmail Notification (SMTP with App Password)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_digit_app_password
NOTIFICATION_RECIPIENT=recipient_email@gmail.com

# ==========================================
# Application Settings
# ==========================================
MAX_RETRIES=3

